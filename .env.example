# Switches the AI reader on. Without any of these the page uses the offline reader.
# Free: a key from Google AI Studio (no card). Free tiers may keep and review what they receive.
GEMINI_API_KEY=

# Also free: a key from build.nvidia.com (trial terms: testing and evaluation only, no personal data)
# NVIDIA_API_KEY=

# Any OpenAI-style endpoint with tool calling (set all three):
# TAREEKH_API_KEY=
# TAREEKH_BASE_URL=
# TAREEKH_MODEL=

# Paid:
# ANTHROPIC_API_KEY=

# Optional
# TAREEKH_PROVIDER=gemini        # gemini | nvidia | custom | anthropic, to force one when several keys are set
# TAREEKH_MODEL=gemini-3.8-flash # model name for the chosen provider
# TAREEKH_PER_MINUTE=4           # requests per visitor per minute
# TAREEKH_DAILY_LIMIT=50         # papers per day for the whole server
# TAREEKH_DEBUG=1                # log the provider's error text when a model call fails
# TAREEKH_CALL_GAP_MS=6500       # live evals only: pause between model calls
